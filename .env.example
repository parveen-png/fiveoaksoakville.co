# Public site identity. Replace placeholders before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_DOMAIN=[DOMAIN]
NEXT_PUBLIC_PUBLISHER_LEGAL_NAME=[PUBLISHER_LEGAL_NAME]
NEXT_PUBLIC_BROKERAGE_LEGAL_NAME=[BROKERAGE_LEGAL_NAME_IF_APPLICABLE]
NEXT_PUBLIC_RECO_REGISTERED_AGENT_NAME=[RECO_REGISTERED_AGENT_NAME_IF_APPLICABLE]
NEXT_PUBLIC_AGENT_DESIGNATION=[AGENT_DESIGNATION_IF_APPLICABLE]
NEXT_PUBLIC_PUBLISHER_ADDRESS=[PUBLISHER_ADDRESS]
NEXT_PUBLIC_PUBLISHER_PHONE=[PUBLISHER_PHONE]
NEXT_PUBLIC_PUBLISHER_EMAIL=[PUBLISHER_EMAIL]
NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy

# Optional public configuration
NEXT_PUBLIC_CRM_OR_WEBHOOK_PROVIDER=[CRM_OR_WEBHOOK_PROVIDER]
NEXT_PUBLIC_LEAD_DESTINATION=[LEAD_DESTINATION]
NEXT_PUBLIC_ACKNOWLEDGEMENT_EMAIL_PROVIDER=[ACKNOWLEDGEMENT_EMAIL_PROVIDER]
NEXT_PUBLIC_ANALYTICS_MEASUREMENT_ID=
NEXT_PUBLIC_LANDING_PAGE_VARIANT=co-oakville-2026-08
NEXT_PUBLIC_ALLOW_FBCLID=false
NEXT_PUBLIC_VERIFIED_PROJECT_COORDINATES=
NEXT_PUBLIC_NOINDEX=true

# Google Sheets lead capture
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Sheet1
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
CRM_OR_WEBHOOK_PROVIDER=
LEAD_DESTINATION=
EMAIL_PROVIDER_API_KEY=
EMAIL_PROVIDER_ENDPOINT=https://api.resend.com/emails
INTERNAL_LEAD_EMAIL=leads@example.test
FROM_EMAIL=updates@example.test
FROM_NAME=[PUBLISHER_LEGAL_NAME]
ACKNOWLEDGEMENT_EMAIL_PROVIDER=

# Search Console / Bing verification tokens if required
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
BING_WEBMASTER_VERIFICATION=

# Rate limiting
RATE_LIMIT_MAX=8
RATE_LIMIT_WINDOW_MS=900000

# Set true only for local/staging tests when no CRM is configured.
# Do not enable this in production with real visitors.
ALLOW_LOCAL_LEAD_CAPTURE=false
